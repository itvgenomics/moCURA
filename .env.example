# Copy this file to .env (at the moCURA root, next to mocura.py) and fill in the key.
# moCURA reads .env by default; --env-file or remote_services.env_file point to another file.
# With NCBI_API_KEY, NCBI and BOLD are queried at 10 requests per second; without it, 3.
# Create a key at https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management).
NCBI_API_KEY=
# Optional: contact address NCBI asks automated clients to send with E-utilities and BLAST.
NCBI_EMAIL=
